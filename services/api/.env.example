# Server-only configuration. Never place keys in apps/web or commit .env.
DATABASE_URL=sqlite:///../../.local/vitaai.db
# sample preserves the synthetic workspace; session requires a provisioned user.
AUTH_MODE=sample
SESSION_HOURS=8
# Enable only for a validated HTTPS deployment; local HTTP needs false.
SESSION_COOKIE_SECURE=false
NEBIUS_API_KEY=
# Discover an NVIDIA Nemotron ID in your account/region before setting it.
NEBIUS_MODEL=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Read-only HubSpot staging. Configure an authorized test portal locally; restart the API.
HUBSPOT_ENABLED=false
# Separate write gate; configuration grants no approval. Increment revision when rebinding credentials/config.
HUBSPOT_WRITE_ENABLED=false
HUBSPOT_CONFIGURATION_REVISION=1
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_ORGANIZATION_ID=
HUBSPOT_PORTAL_ID=
# JSON object mapping existing VitaAi account UUIDs to allowed numeric company IDs (max 50).
HUBSPOT_COMPANY_MAP={}
# Explicit target -> property/type/unit/meaning/measurement-time mapping; see README.
HUBSPOT_PROPERTY_MAP={}

# Delegated Microsoft test-mailbox integration, disabled until explicitly configured.
MICROSOFT_ENABLED=false
MICROSOFT_WRITE_ENABLED=false
MICROSOFT_CONFIGURATION_REVISION=1
MICROSOFT_ORGANIZATION_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Stable locally generated Fernet key for encrypted OAuth storage; keep outside source.
MICROSOFT_TOKEN_KEY=
MICROSOFT_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/microsoft/callback

# Read-only advisory research. Explicit live request and both gates are required.
RESEARCH_ENABLED=false
RESEARCH_LIVE_ENABLED=false
RESEARCH_API_KEY=
RESEARCH_ORGANIZATION_ID=
# Account UUID -> {"company_name":"Authorized public name","domain":"example.com"}; max 50.
RESEARCH_ACCOUNT_MAP={}
