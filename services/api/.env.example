# Server-only configuration. Never place keys in apps/web or commit .env.
DATABASE_URL=sqlite:///../../.local/vitaai.db
# sample preserves the synthetic workspace; session requires a provisioned user.
AUTH_MODE=sample
SESSION_HOURS=8
# Enable only for a validated HTTPS deployment; local HTTP needs false.
SESSION_COOKIE_SECURE=false
# Optional exact HTTPS DNS origin for ordinary hosted sessions, e.g. https://vitaai.example.
# Requires AUTH_MODE=session and SESSION_COOKIE_SECURE=true; no port/path/trailing slash.
# Set the same exact VITAAI_WEB_ORIGIN on the web server; Microsoft/Teams stay independently gated.
WEB_ORIGIN=
NEBIUS_API_KEY=
# Discover an NVIDIA Nemotron ID in your account/region before setting it.
NEBIUS_MODEL=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Independent comparison catalog; never inherits NEBIUS_API_KEY. Server-controlled endpoints/models.
# Optional comparison/admin-discovery request keys need this gate; no persistence or model/endpoint override.
COMPARISON_ORGANIZATION_ID=
COMPARISON_BYOK_ENABLED=false
# Separate explicit synthetic inference probes; no account data is sent. Never grants live-call authority.
COMPARISON_TEST_ENABLED=false
# Provider -> {"enabled":false,"live_enabled":false,"api_key":"","model":"","response_model":"","allowed_models":{},"revision":1}
# Allowed provider IDs: nebius, openai, anthropic, nvidia, foundry. Defaults deny network access.
# Foundry also needs resource_name (Azure resource DNS label); endpoint_domain is
# services.ai.azure.com (default) or openai.azure.com. No full/custom endpoint is accepted.
# Foundry model is a deployed name; discovery returns model IDs, not deployment readiness.
# Optional response_model binds the exact canonical response ID; empty defaults to model.
# Optional allowed_models maps up to 20 selectable requested IDs to exact expected response IDs.
# Default model remains required for live eligibility; an allowlist alone does not configure a provider.
# Discovery never adds choices. Restart/increment revision after changing model bindings.
COMPARISON_PROVIDERS={}

# Read-only HubSpot staging. Configure an authorized test portal locally; restart the API.
HUBSPOT_ENABLED=false
# Separate explicit read-only mapped-company connection check; never runs on startup.
HUBSPOT_PROBE_ENABLED=false
# Explicit associated-object staging; server bounds are part of its displayed configuration binding.
HUBSPOT_INGESTION_ENABLED=false
HUBSPOT_INGESTION_OBJECT_LIMIT=20
HUBSPOT_INGESTION_PAGE_LIMIT=5
# Separate write gate; configuration grants no approval. Increment revision when rebinding credentials/config.
HUBSPOT_WRITE_ENABLED=false
# Separate synthetic seed gate and explicit test portal (must match HUBSPOT_PORTAL_ID).
# Exact saved review is still required; no automatic seed or cleanup occurs.
HUBSPOT_SEED_ENABLED=false
HUBSPOT_SEED_TEST_PORTAL_ID=
# Optional deal seeds require explicit portal pipeline/stage IDs; no amount/close date is inferred.
HUBSPOT_SEED_DEAL_PIPELINE=
HUBSPOT_SEED_DEAL_STAGE=
HUBSPOT_REFRESH_ENABLED=false
HUBSPOT_REFRESH_WORKER_ENABLED=false
HUBSPOT_CONFIGURATION_REVISION=1
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_ORGANIZATION_ID=
HUBSPOT_PORTAL_ID=
# JSON object mapping existing VitaAi account UUIDs to allowed numeric company IDs (max 50).
HUBSPOT_COMPANY_MAP={}
# Explicit target -> property/type/unit/meaning/measurement-time mapping; see README.
HUBSPOT_PROPERTY_MAP={}

# Delegated Microsoft test-mailbox integration, disabled until explicitly configured.
MICROSOFT_ENABLED=false
MICROSOFT_WRITE_ENABLED=false
MICROSOFT_REFRESH_ENABLED=false
MICROSOFT_CONFIGURATION_REVISION=1
MICROSOFT_ORGANIZATION_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Stable locally generated Fernet key for encrypted OAuth storage; keep outside source.
MICROSOFT_TOKEN_KEY=
MICROSOFT_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/microsoft/callback
# Hosted callback: same HTTPS origin and SESSION_COOKIE_SECURE=true; also set web VITAAI_WEB_ORIGIN.
MICROSOFT_WEB_ORIGIN=

# Read-only advisory research. Explicit live request and both gates are required.
RESEARCH_ENABLED=false
RESEARCH_LIVE_ENABLED=false
RESEARCH_API_KEY=
RESEARCH_ORGANIZATION_ID=
# Account UUID -> {"company_name":"Authorized public name","domain":"example.com"}; max 50.
RESEARCH_ACCOUNT_MAP={}
# Optional per-target company_domains and identity_terms default to empty lists.
# Default-off explicit archive gate over separately reviewed verified synthetic seed IDs.
HUBSPOT_CLEANUP_ENABLED=false

# Separate advisory Nebius narrative gate/key; never inherits NEBIUS_API_KEY or comparison credentials.
# {"enabled":false,"live_enabled":false,"api_key":"","model":"","response_model":"","revision":1}
RESEARCH_NARRATIVE_PROVIDER={}
